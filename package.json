  "scripts": {
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider react-scripts start",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "zip:export": "zip -r public/stonewellfinancial-frontend.zip src netlify/functions package.json package-lock.json netlify.toml .env.example public -x \"node_modules/*\" \"*/node_modules/*\" \"build/*\" \"*/build/*\" \"dist/*\" \"*/dist/*\" \".cache/*\" \"*/.cache/*\" \".git/*\" \"*/.git/*\"",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "netlify:dev": "netlify dev",
    "lint:funcs": "tsc -p netlify/functions/tsconfig.json --noEmit",
    "smoke:health": "curl -s http://localhost:8888/.netlify/functions/health || true",
    "smoke:quote": "curl -s http://localhost:8888/.netlify/functions/quoteHealth || true",
    "admin:migrate": "curl -s -X POST http://localhost:8888/.netlify/functions/adminRunMigrations -H \"x-admin-token: $ADMIN_TASK_TOKEN\" || true",
    "postinstall": "echo 'Install complete. Run with: npm start or npx netlify dev'"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "proxy": "http://localhost:5000",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
